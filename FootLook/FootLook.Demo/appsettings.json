{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FootLook": {
    "UseMongoSink": false,
      "IgnoredPathPrefixes": [
        "/.git",
        "/.env",
        "/.aws",
        "/.DS_Store",
        "/wp-",
        "/php",
        "/boaform",

        "/robots*",
        "/sitemap*",
        "/ads.txt",
        "/app-ads.txt",
        "/humans.txt",
        "/security.txt",
        "/browserconfig.xml",
        "/apple-touch-icon*",
        "/xmlrpc.php"
      ]
  }
}
